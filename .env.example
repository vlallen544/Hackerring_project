# VidyaPath — environment variables
# Copy to `.env` and fill in real values. Keys are only read server-side.

# Agnes AI API (OpenAI-compatible)
AGNES_API_KEY=your_key_here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-3.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.5-flash

# Database: sqlite:///./vidyapath.db  |  postgres://user:pass@host/db
DATABASE_URL=sqlite:///./vidyapath.db

# Rate-limit / reliability
MAX_REQUESTS_PER_MINUTE=60
REQUEST_TIMEOUT_SECONDS=120
