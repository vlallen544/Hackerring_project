AGNES_API_KEY=replace_with_your_api_key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-3.0-flash

# Claude (Anthropic) for heavy tasks: reading whole courses / PDFs, reconciling sources.
# Leave ANTHROPIC_API_KEY empty to run everything on Agnes.
ANTHROPIC_API_KEY=
HEAVY_LLM_PROVIDER=claude
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# Database. Empty = local SQLite files in data/. Set to Postgres (Supabase: Connect -> Session pooler URI)
# to use it instead; special characters in the password must be URL-encoded (@ -> %40).
DATABASE_URL=
DB_POOL_SIZE=5

# Logins. Password for the master faculty login `admin`, used only when it is first created (default admin123).
ADMIN_PASSWORD=
# Secret that signs login tokens. Set it on a hosted server so logins survive restarts.
JWT_SECRET=

# Uploaded documents in Supabase Storage (optional; without it they are kept in Postgres)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=sources

# Read aloud (optional): Piper voice from huggingface.co/rhasspy/piper-voices; pyttsx3/espeak-ng is the fallback
PIPER_VOICE=en_US-lessac-medium
PIPER_SPEAKER=
TTS_SPEED=1.05
TTS_THREADS=0
